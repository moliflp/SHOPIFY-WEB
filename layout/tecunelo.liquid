.ts{left:12px;right:12px;bottom:calc(14px + env(safe-area-inset-bottom,0px));transform:translate(0,160%);max-width:440px;margin:0 auto;width:auto;gap:12px;padding:10px 12px 10px 10px;border-radius:18px;background:rgb(10 20 14/.94);border:1px solid rgb(255 255 255/.12);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);box-shadow:0 14px 40px rgb(0 0 0/.5);font-size:14px;opacity:0;transition:transform .45s var(--e),opacity .3s}
