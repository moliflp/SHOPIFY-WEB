<style>
@font-face{font-family:Anton;src:url(fonts/anton-400.woff2) format("woff2");font-weight:400;font-display:swap}
@font-face{font-family:Manrope;src:url(fonts/manrope-var.woff2) format("woff2");font-weight:300 800;font-display:swap}
:root{--bg:#06100A;--glass:rgb(6 16 10/.6);--ink:#F1F4E8;--mut:#A4B09C;--line:#22352A;--card:#0E1D14;--ac:hsl(75 100% 62%);--e:cubic-bezier(.22,1,.36,1);--s:cubic-bezier(.65,0,.35,1);color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root:not([data-theme="light"]),:root[data-theme="dark"]{--bg:#06100A}
html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px);overflow-x:clip;overscroll-behavior-x:none}
html,body{max-width:100%;touch-action:pan-y pinch-zoom}
*{box-sizing:border-box;margin:0}
body{background:var(--bg);color:var(--ink);font:400 17px/1.5 Manrope,sans-serif;overflow-x:clip}
a{color:inherit;text-decoration:none}
#gl{position:fixed;inset:0;width:100%;height:100%;z-index:0}
main,header,footer,.nl{position:relative;z-index:1}
.disp{font-family:Anton,Impact,sans-serif;text-transform:uppercase;font-weight:400;line-height:.92}
.wrap{max-width:1240px;margin:0 auto;padding:0 24px}
.js .rv{opacity:0;transform:perspective(900px) translateY(50px) rotateX(16deg);filter:blur(8px);transition:opacity .9s var(--e) var(--d,0ms),transform .9s var(--e) var(--d,0ms),filter .9s var(--e) var(--d,0ms)}
.js .rv.in{opacity:1;transform:none;filter:none}
.js .row.rv{transition:opacity .9s var(--e),transform .9s var(--e),filter .9s var(--e),padding .4s var(--e)}

#ld{position:fixed;inset:0;z-index:100;background:var(--bg);display:flex;align-items:center;justify-content:center;gap:16px;font:400 clamp(28px,6vw,64px) Anton,sans-serif;text-transform:uppercase;transition:opacity .6s var(--e)}
#ld.off{opacity:0;pointer-events:none}
#ld b{color:var(--ac);font-weight:400}

#promo{position:absolute;top:0;left:0;width:100%;z-index:7;background:var(--ac);color:#0A1408;text-align:center;padding:8px 12px;font:600 14px Manrope,sans-serif}

header{position:fixed;top:36px;left:12px;width:calc(100% - 24px);display:flex;justify-content:space-between;align-items:center;padding:8px 10px 8px 8px;z-index:50;border-radius:999px;background:linear-gradient(145deg,rgb(255 255 255/.14),rgb(255 255 255/.04)),rgb(10 22 14/.35);border:1px solid rgb(255 255 255/.18);-webkit-backdrop-filter:blur(22px) saturate(180%);backdrop-filter:blur(22px) saturate(180%);box-shadow:inset 0 1px 0 rgb(255 255 255/.4),0 16px 40px rgb(0 0 0/.3);transition:padding .3s var(--e),background .3s,border-color .3s}
header.sc{background:linear-gradient(145deg,rgb(255 255 255/.14),rgb(255 255 255/.04)),rgb(10 22 14/.6)}
.logo{font:400 26px Anton,sans-serif;text-transform:uppercase}
header nav{display:flex;gap:28px;color:var(--mut)}
.hb,#cart{background:rgb(255 255 255/.1);border:1px solid rgb(255 255 255/.18);box-shadow:inset 0 1px 0 rgb(255 255 255/.4)}
#cart{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:8px 18px;font:600 16px Manrope,sans-serif;cursor:pointer;color:var(--ink)}
#cart svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
#cart b{min-width:24px;height:24px;border-radius:999px;background:var(--ac);color:#0A1408;display:inline-flex;align-items:center;justify-content:center;font-size:13px;padding:0 6px}
#cart.bump b{animation:bump .5s var(--e)}
@keyframes bump{40%{transform:scale(1.6)}}

.hero{min-height:100vh;min-height:100dvh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:120px 20px 24px;position:relative}
h1{font-size:clamp(60px,15vw,230px)}
h1 em{display:block;font-style:normal;color:var(--ac);font-size:clamp(26px,6.4vw,96px);min-height:1em;margin-top:6px}
.hero p{max-width:460px;color:var(--mut);margin:20px 0 0}
.hero p.cp{position:absolute;bottom:128px}
#h1{will-change:transform}
.lt{display:inline-block;opacity:0}
.go .lt{animation:lt 1s var(--e) both;animation-delay:calc(var(--i)*55ms)}
@keyframes lt{from{opacity:0;transform:perspective(600px) rotateX(-95deg) translateY(.4em) scale(.9);filter:blur(10px)}to{opacity:1;transform:none;filter:none}}

.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 28px;border-radius:999px;background:var(--ac);color:#0A1408;font:600 16px Manrope,sans-serif;border:0;cursor:pointer;transition:transform .2s ease-out;position:relative;overflow:hidden;background-image:linear-gradient(180deg,rgb(255 255 255/.5),rgb(255 255 255/0) 55%);box-shadow:inset 0 1px 0 rgb(255 255 255/.75),0 10px 28px color-mix(in srgb,var(--ac) 40%,transparent)}
.btn::after{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 35%,rgb(255 255 255/.6) 50%,transparent 65%);transform:translateX(-130%);animation:sh 4s ease-in-out infinite;pointer-events:none}
@keyframes sh{0%,60%{transform:translateX(-130%)}100%{transform:translateX(130%)}}
.btn.g{background:rgb(255 255 255/.08);background-image:none;border:1px solid rgb(255 255 255/.18);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:inset 0 1px 0 rgb(255 255 255/.4);color:var(--ink)}
.btn.g::after,.btn:disabled::after{display:none}
.btn.sm{min-height:40px;padding:0 18px;font-size:14px;align-self:flex-start;transform:translateZ(30px)}
.btn:disabled{opacity:.4;cursor:not-allowed}

#c{position:absolute;bottom:40px;left:50%;transform:translateX(-50%);width:min(880px,calc(100vw - 32px));height:64px;z-index:6;transition:width 800ms var(--s);--cl:-5px;--cw:calc(16.666% + 5px)}
#c.sel{width:220px}
.gl{position:absolute;border-radius:999px;pointer-events:none;-webkit-backdrop-filter:blur(12px) saturate(130%);backdrop-filter:blur(12px) saturate(130%)}
.gl::after{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;background:conic-gradient(from 225deg,var(--ac),rgb(255 255 255/.35),#fff,rgb(255 255 255/.35),var(--ac));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:.35}
.tk{inset:3px 0;background:rgb(20 50 32/.4);box-shadow:inset 1px 1px 0 rgb(255 255 255/.4),0 14px 38px rgb(0 0 0/.3);transition:opacity .4s linear}
#c.sel .tk{opacity:0;transition-delay:.5s}
.cp2{top:-4px;height:72px;left:var(--cl);width:var(--cw);background:rgb(240 255 235/.14);box-shadow:inset 1px 1px 0 rgb(255 255 255/.55),0 11px 28px rgb(0 0 0/.3);transition:left 620ms var(--e),width 620ms var(--e)}
#c.sel .cp2{left:-5px;width:calc(100% + 10px);transition:left 800ms var(--s),width 800ms var(--s)}
.cells{position:absolute;inset:0;display:grid;grid-template-columns:repeat(6,1fr);align-items:center;z-index:1}
#c.sel .cells{grid-template-columns:1fr}
.cell{display:flex;align-items:center;justify-content:center;height:100%;font:400 19px Manrope,sans-serif;letter-spacing:-.02em;white-space:nowrap;background:transparent;color:var(--ink);border:0;border-radius:999px;cursor:pointer;transition:opacity .4s var(--e),filter .4s var(--e)}
.cell.lb{cursor:default;pointer-events:none}
#c.sel .cell:not(.reset){position:absolute;opacity:0;filter:blur(8px);pointer-events:none}
.reset{text-decoration:underline;text-underline-offset:3px}

.band{overflow:hidden;border-block:1px solid var(--line);padding:14px 0;margin-top:0;background:rgb(6 16 10/.75);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
.track{display:flex;gap:48px;width:max-content;animation:mq 28s linear infinite}
.track span{font:400 clamp(44px,7vw,96px) Anton,sans-serif;text-transform:uppercase;color:transparent;-webkit-text-stroke:1px var(--ac)}
@keyframes mq{to{transform:translateX(-50%)}}

.msg{padding:100px 0 90px;background:var(--glass);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px)}
.msg p{font:600 clamp(26px,4.2vw,58px)/1.12 Manrope,sans-serif;letter-spacing:-.03em;max-width:17em}
.msg b{color:var(--ac);font-weight:700}
.msg svg{display:block;margin-top:28px;width:150px;stroke:var(--ac);fill:none;stroke-width:3;stroke-linecap:round}
.hk{display:flex;flex-wrap:wrap;gap:12px;margin-top:40px;list-style:none;padding:0;counter-reset:h}
.hk li{border:1px solid rgb(255 255 255/.18);border-radius:999px;padding:8px 18px;color:var(--mut);font-size:15px;background:rgb(255 255 255/.07);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:inset 0 1px 0 rgb(255 255 255/.3)}
.hk li b{color:var(--ac);font-weight:700}
.hk li::before{counter-increment:h;content:counter(h,decimal-leading-zero);color:var(--ac);font-weight:700;font-size:13px;margin-right:10px}
.msg .btn{margin-top:36px}
.js .hk li.in:hover{transform:translateY(-4px) perspective(600px) rotateX(8deg);border-color:var(--ac)}

.top{background:var(--glass);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);padding:60px 0 100px;scroll-margin-top:72px}
.top .h{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:20px;margin-bottom:36px}
.top h2{font-size:clamp(48px,9vw,130px)}
.rail{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,270px),1fr));gap:20px;padding:0 24px 28px;max-width:1240px;margin:0 auto}
.tilt{position:relative;height:420px;background:linear-gradient(145deg,rgb(255 255 255/.14),rgb(255 255 255/.04)),rgb(10 22 14/.35);border:1px solid rgb(255 255 255/.18);border-radius:32px;padding:20px;display:flex;flex-direction:column;justify-content:space-between;transform-style:preserve-3d;transition:box-shadow .3s ease-out;overflow:hidden;--gx:50%;--gy:50%;-webkit-backdrop-filter:blur(14px) saturate(170%);backdrop-filter:blur(14px) saturate(170%);box-shadow:var(--gs),calc(var(--tx,0)*-26px) calc(var(--ty,0)*-26px + 20px) 44px -14px rgb(0 0 0/calc(.2 + var(--o,0)*.4));cursor:pointer}
.tilt:nth-child(even){border-radius:8px 44px 8px 44px}
.tilt::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at var(--gx) var(--gy),rgb(255 255 255/.7),rgb(255 255 255/.14) 26%,transparent 52%);mix-blend-mode:overlay;opacity:var(--o,0);z-index:3;pointer-events:none}
.tilt::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1.5px;background:radial-gradient(170px circle at var(--gx) var(--gy),rgb(255 255 255/.95),transparent 70%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:var(--o,0);pointer-events:none;z-index:4}
.ph{flex:1;margin-bottom:16px;border-radius:20px;background:rgb(0 0 0/.22);box-shadow:inset 0 1px 0 rgb(255 255 255/.12);display:flex;align-items:center;justify-content:center;color:var(--mut);position:relative;overflow:hidden;transform:translate(calc(var(--tx,0)*-12px),calc(var(--ty,0)*-12px))}
.tilt:hover .ph{color:#0A1408}
.ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:20px}
.tilt h3{font:400 26px Anton,sans-serif;text-transform:uppercase;transform:translate(calc(var(--tx,0)*9px),calc(var(--ty,0)*9px))}
.tilt .pr{display:flex;justify-content:space-between;color:var(--mut);transform:translate(calc(var(--tx,0)*9px),calc(var(--ty,0)*9px))}
.tilt .sv{color:var(--ac);font-size:14px;font-weight:600;transform:translate(calc(var(--tx,0)*9px),calc(var(--ty,0)*9px))}
.tilt .btn.sm{transform:translate(calc(var(--tx,0)*9px),calc(var(--ty,0)*9px))}
body[data-cat="1"] .tilt:not([data-c="1"]),body[data-cat="2"] .tilt:not([data-c="2"]),body[data-cat="3"] .tilt:not([data-c="3"]),body[data-cat="4"] .tilt:not([data-c="4"]),body[data-cat="5"] .tilt:not([data-c="5"]){display:none}
.bd{position:absolute;top:16px;left:16px;z-index:2;background:var(--ac);color:#0A1408;font:700 14px Manrope,sans-serif;padding:4px 12px;border-radius:999px;transform:translate(calc(var(--tx,0)*16px),calc(var(--ty,0)*16px))}
.bd.h{left:auto;right:16px;background:#fff;animation:pl 2s ease-in-out infinite}
@keyframes pl{50%{box-shadow:0 0 0 7px rgb(255 255 255/0),0 0 22px rgb(255 255 255/.7)}}
.tilt .pn{font:400 30px Anton,sans-serif;color:var(--ac)}
.tilt .po{font:400 16px Manrope,sans-serif;color:var(--mut);margin-left:8px}
.ph svg{width:96px;height:96px}
.nt{color:var(--mut);font-size:13px;margin-top:8px}
.cnt{color:var(--mut);font-size:15px;margin:-8px auto 20px}
.tilt[hidden]{display:none}
.top .nt{padding:0 24px}

.rows{background:var(--glass);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);padding:40px 0 140px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:16px 32px;align-items:center;padding:28px 0;border-top:1px solid var(--line);transition:padding .4s var(--e)}
.row:last-child{border-bottom:1px solid var(--line)}
.row h3{font-size:clamp(48px,9vw,128px);transition:color .3s}
.row>span,.row>div{color:var(--mut);font-size:19px}
.row:hover{padding-left:20px}.row:hover h3{color:var(--ac)}
.pasos{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding:0 0 64px}
.pa{border:1px solid rgb(255 255 255/.18);border-radius:28px;padding:28px;background:rgb(255 255 255/.07);display:flex;flex-direction:column;gap:8px;overflow:hidden;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:inset 0 1px 0 rgb(255 255 255/.3)}
.pa i{font:400 96px/1 Anton,sans-serif;font-style:normal;color:transparent;-webkit-text-stroke:1px var(--ac)}
.pa h3{font-size:clamp(36px,5vw,56px)}
.pa span{color:var(--mut)}
.js .pa.in:hover{transform:perspective(900px) rotateX(6deg) rotateY(-8deg) translateY(-8px);border-color:var(--ac)}
.pay{display:flex;flex-wrap:wrap;gap:10px;list-style:none;padding:0;margin-top:16px}
.pay li{border:1px solid rgb(255 255 255/.18);border-radius:12px;padding:8px 16px;font:600 15px Manrope,sans-serif;color:var(--ink);background:rgb(255 255 255/.07);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:inset 0 1px 0 rgb(255 255 255/.3)}

footer{background:var(--glass);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);padding:48px 24px 48px;border-top:1px solid var(--line)}
.nl h2{font-size:clamp(44px,11vw,170px);max-width:12em}
form{display:flex;flex-wrap:wrap;gap:12px;margin:36px 0 56px}
input{min-height:48px;padding:0 20px;border-radius:999px;border:1px solid rgb(255 255 255/.18);background:rgb(255 255 255/.08);color:var(--ink);font:16px Manrope,sans-serif;width:min(100%,320px);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
.fl{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;color:var(--mut);font-size:14px}
.fl a{text-decoration:underline;text-underline-offset:3px;margin-right:14px}
.nl{background:var(--glass);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);padding:100px 24px 24px;border-top:1px solid var(--line)}
footer .pay{margin:0 0 28px}
.lg{border-top:1px solid var(--line);border-radius:20px;padding:16px 20px;margin-bottom:10px;background:rgb(255 255 255/.07);border:1px solid rgb(255 255 255/.18);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:inset 0 1px 0 rgb(255 255 255/.3)}
.lg summary{cursor:pointer;font:600 17px Manrope,sans-serif;list-style:none}
.lg summary::-webkit-details-marker{display:none}
.lg summary::after{content:"+";float:right;color:var(--ac)}
.lg[open] summary::after{content:"–"}
.lg p{color:var(--mut);margin-top:10px;font-size:15px;max-width:60ch}
.lg:last-of-type{border-bottom:1px solid var(--line);margin-bottom:32px}

.lh{display:flex;align-items:center}
.hb{display:inline-flex;flex-direction:column;justify-content:center;align-items:center;gap:5px;width:44px;height:44px;border-radius:999px;background:rgb(255 255 255/.1);border:1px solid rgb(255 255 255/.18);box-shadow:inset 0 1px 0 rgb(255 255 255/.4);cursor:pointer;margin-right:12px}
.hb i{display:block;width:18px;height:2px;background:var(--ink);border-radius:2px;transition:transform .3s var(--e)}
.hb:hover i:nth-child(1){transform:translateX(3px)}.hb:hover i:nth-child(3){transform:translateX(-3px)}
.dr{position:fixed;top:12px;bottom:12px;width:min(420px,calc(100vw - 24px));z-index:60;border-radius:32px;background:linear-gradient(145deg,rgb(255 255 255/.14),rgb(255 255 255/.04)),rgb(10 22 14/.55);border:1px solid rgb(255 255 255/.18);-webkit-backdrop-filter:blur(30px) saturate(200%);backdrop-filter:blur(30px) saturate(200%);box-shadow:inset 0 1px 0 rgb(255 255 255/.5),0 30px 80px rgb(0 0 0/.55);padding:calc(24px + env(safe-area-inset-top,0px)) 24px calc(24px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;gap:12px;overflow-y:auto;visibility:hidden;transition:transform .55s var(--e),visibility 0s linear .55s}
.dr.l{left:12px;transform:translateX(-115%)}
.dr.r{right:12px;transform:translateX(115%)}
.dr.on{transform:none;visibility:visible;transition:transform .55s var(--e),visibility 0s}
.ov{position:fixed;inset:0;z-index:55;background:rgb(0 0 0/.55);opacity:0;pointer-events:none;transition:opacity .4s}
.ov.on{opacity:1;pointer-events:auto}
body.nsc{overflow:hidden}
.dh{display:flex;justify-content:space-between;align-items:center}
.dh h2{font-size:44px}
.x{width:44px;height:44px;border:1px solid var(--line);border-radius:999px;background:transparent;color:var(--ink);font-size:18px;cursor:pointer}
.mi{display:flex;justify-content:space-between;align-items:center;width:100%;padding:18px 4px;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--ink);font:400 34px Anton,sans-serif;text-transform:uppercase;cursor:pointer;text-align:left;transition:padding .3s var(--e),color .3s}
.mi em{font:600 14px Manrope,sans-serif;color:var(--mut);font-style:normal}
.mi:hover,.mi.a{padding-left:14px;color:var(--ac)}
.ml{display:flex;gap:18px;color:var(--mut);margin-top:auto;padding-top:12px}

.ci{display:grid;grid-template-columns:1fr auto;gap:4px 12px;padding:14px 0;border-bottom:1px solid var(--line)}
.ci b:nth-child(2){text-align:right}.ci span{color:var(--mut);font-size:14px}
.q{display:flex;align-items:center;gap:8px;justify-self:end;grid-column:2}
.q button{width:32px;height:32px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--ink);cursor:pointer;font-size:18px}
.tot{display:flex;justify-content:space-between;font:400 32px Anton,sans-serif;text-transform:uppercase;margin-top:auto}
.vac{color:var(--mut)}

#au{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none}
#au i{position:absolute;width:70vmax;height:70vmax;border-radius:50%;animation:au 22s ease-in-out infinite alternate}
#au i:nth-child(1){left:-25vmax;top:-20vmax;background:radial-gradient(circle,color-mix(in srgb,var(--ac) 38%,transparent),transparent 65%)}
#au i:nth-child(2){right:-30vmax;top:30vh;animation-duration:28s;background:radial-gradient(circle,rgb(0 140 255/.26),transparent 65%)}
#au i:nth-child(3){left:10vmax;bottom:-35vmax;animation-duration:34s;background:radial-gradient(circle,rgb(190 80 255/.22),transparent 65%)}
