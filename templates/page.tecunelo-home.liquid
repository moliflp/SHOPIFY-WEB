{% layout none %}
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TECUNELO — Tienda Oficial</title>
  
  <!-- Carga segura de estilos principales adaptados a Shopify -->
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body>

  <!-- INICIO DE TU DISEÑO TECUNELO -->
  <header>
    <h1>Bienvenido a TECUNELO</h1>
  </header>

  <main>
    <section class="hero-section">
      <p>Tu tienda online configurada y lista para funcionar en Shopify.</p>
      
      <!-- Ejemplo de integración con el carrito y pasarela de Shopify -->
      <form action="{{ routes.cart_url }}" method="post" id="cart">
        <div class="product-actions">
          <!-- Si deseas añadir un producto de prueba, puedes usar su variant_id -->
          <input type="hidden" name="id" value="TU_VARIANTE_ID">
          <button type="submit" name="checkout" class="btn-pagar">
            Pagar / Finalizar Compra Segura
          </button>
        </div>
      </form>
    </section>
  </main>

  <footer>
    <p>&copy; {{ 'now' | date: '%Y' }} TECUNELO. Todos los derechos reservados.</p>
    <p><small>Cumplimiento normativo LSSI-CE y normativa de consumo (Junta de Andalucía).</small></p>
  </footer>
  <!-- FIN DE TU DISEÑO TECUNELO -->

  <!-- Scripts opcionales de Shopify o personalizados -->
  {{ 'global.js' | asset_url | script_tag }}
</body>
</html>
